{
  "name": "transcribee",
  "productName": "TranscriBee",
  "version": "1.0.0",
  "description": "A music-transcription player: slow down, pitch-shift, EQ and loop songs and videos, and step through them with the keyboard.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:gpu-info": "electron . --gpu-info",
    "start:no-gpu": "electron . --disable-gpu",
    "test": "node tests/launch.cjs",
    "test:fixtures": "bash tests/make-fixtures.sh",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "music",
    "transcription",
    "audio",
    "slow-down",
    "electron"
  ],
  "author": "Wiktor Wieczorkiewicz",
  "license": "ISC",
  "private": true,
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "mediabunny": "^1.61.3",
    "signalsmith-stretch": "1.3.2",
    "wavesurfer.js": "^8.0.1"
  },
  "build": {
    "appId": "com.transcribee.app",
    "productName": "TranscriBee",
    "win": {
      "signAndEditExecutable": false,
      "target": "portable"
    }
  }
}
