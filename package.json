{
  "name": "transcribee",
  "productName": "TranscriBee",
  "version": "1.0.0",
  "description": "A music-transcription player: slow down, pitch-shift, EQ and loop songs and videos, and step through them with the keyboard.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:gpu-info": "electron . --gpu-info",
    "start:no-gpu": "electron . --disable-gpu",
    "test": "node tests/launch.cjs",
    "test:fixtures": "bash tests/make-fixtures.sh",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "build:dir": "electron-builder --linux --dir",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "music",
    "transcription",
    "audio",
    "slow-down",
    "electron"
  ],
  "author": "Wiktor Wieczorkiewicz",
  "license": "ISC",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "mediabunny": "^1.61.3",
    "signalsmith-stretch": "1.3.2",
    "wavesurfer.js": "^8.0.1"
  },
  "build": {
    "appId": "com.transcribee.app",
    "productName": "TranscriBee",
    "icon": "assets/icon-512.png",
    "files": [
      "electron/**",
      "index.html",
      "style.css",
      "script.js",
      "assets/logo.webp",
      "assets/icon-512.png",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "executableName": "transcribee",
      "category": "Audio"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": "portable",
      "icon": "assets/icon.ico"
    }
  }
}
