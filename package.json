{
  "name": "earbee",
  "productName": "EarBee",
  "version": "0.2.0",
  "description": "A music-transcription player: slow down, pitch-shift, EQ and loop songs and videos, and step through them with the keyboard.",
  "author": "Wiktor Wieczorkiewicz",
  "license": "MIT",
  "homepage": "https://earbee.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiktor-rocks/earbee.git"
  },
  "bugs": {
    "url": "https://github.com/wiktor-rocks/earbee/issues"
  },
  "main": "electron/main.js",
  "desktopName": "earbee.desktop",
  "scripts": {
    "start": "electron .",
    "start:gpu-info": "electron . --gpu-info",
    "start:no-gpu": "electron . --disable-gpu",
    "test": "node tests/launch.cjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:fixtures": "bash tests/make-fixtures.sh",
    "diagnose:loading": "bash tests/diagnostics/make-long-media.sh && node tests/diagnostics/run.cjs",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json && tsc -p electron/jsconfig.json",
    "build:dir": "electron-builder --linux --dir",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "keywords": [
    "music",
    "transcription",
    "audio",
    "slow-down",
    "electron"
  ],
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "mediabunny": "^1.61.3",
    "onnxruntime-node": "1.30.0",
    "wavesurfer.js": "^8.0.1"
  },
  "build": {
    "appId": "com.earbee.app",
    "productName": "EarBee",
    "icon": "assets/icon-512.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "files": [
      "electron/**",
      "index.html",
      "style.css",
      "src/**",
      "models/**",
      "assets/logo.webp",
      "assets/icon-512.png",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v*/!(${platform})/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/${platform}/!(${arch})/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/x64/libonnxruntime_providers_{cuda,tensorrt}.so"
    ],
    "asarUnpack": [
      "models/**",
      "node_modules/onnxruntime-node/bin/**"
    ],
    "linux": {
      "target": "AppImage",
      "executableName": "earbee",
      "category": "Audio",
      "syncDesktopName": true
    },
    "win": {
      "signAndEditExecutable": false,
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false
    }
  }
}
